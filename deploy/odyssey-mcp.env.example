CLICKHOUSE_HOST=replace-with-clickhouse-host
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=true
CLICKHOUSE_USER=sourcecut_mcp
CLICKHOUSE_PASSWORD=replace-with-secret-manager-reference
CLICKHOUSE_DATABASE=sourcecut
CLICKHOUSE_READONLY=1
CLICKHOUSE_ALLOW_WRITE_ACCESS=false
CLICKHOUSE_MCP_SERVER_TRANSPORT=streamable_http
CLICKHOUSE_MCP_BIND_HOST=127.0.0.1
CLICKHOUSE_MCP_BIND_PORT=8000
CLICKHOUSE_MCP_AUTH_TOKEN=replace-with-secret-manager-reference
CLICKHOUSE_MCP_CLIENT_TIMEOUT=30
CLICKHOUSE_MCP_MAX_RESULT_ROWS=500
CLICKHOUSE_MCP_MAX_RESULT_BYTES=2000000
