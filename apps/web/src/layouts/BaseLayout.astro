---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SourceCut — Lewis and Clark expedition research for production",
  description =
    "Scene research from the journals Lewis, Clark and Gass kept on the Lewis and Clark " +
    "expedition: verbatim passages with exact character offsets, and rights-cleared " +
    "Library of Congress references.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#111719" />
    <meta name="description" content={description} />
    <link rel="icon" href="/icon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
