---
import SourceCutLanding from "../components/sourcecut/SourceCutLanding";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadCaptures, loadScopes } from "../lib/examples";
import { summarise } from "../components/sourcecut/types";
import "../styles/sourcecut.css";

export const prerender = true;

const scopes = loadScopes();
const boards = loadCaptures().map((entry) => summarise(entry.captured));
if (boards.length === 0) {
  console.warn(
    `[sourcecut] no captured board found (looked from ${process.cwd()}); ` +
      "the scope directory will offer every window as a live brief.",
  );
}
---

<BaseLayout>
  <SourceCutLanding client:load scopes={scopes} boards={boards} />
</BaseLayout>
