---
import CorpusLanding from "../components/sourcecut/CorpusLanding";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadPipelines } from "../lib/examples";
import "../styles/sourcecut.css";

export const prerender = true;

// The front page is the corpus shelf. Each project has its own dashboard;
// this page only has to say what they are and let a reader pick one.
const pipelines = loadPipelines();
if (pipelines.length === 0) {
  console.warn(
    `[sourcecut] no corpus snapshot found (looked from ${process.cwd()}); ` +
      "run sourcecut-capture-corpora against the MCP server.",
  );
}
---

<BaseLayout
  title="SourceCut — research a scene against the record it came from"
  description="Primary-source research for production: verbatim passages with exact character offsets, rights-cleared references, and what the corpus cannot support said out loud."
>
  <CorpusLanding client:load pipelines={pipelines} />
</BaseLayout>
